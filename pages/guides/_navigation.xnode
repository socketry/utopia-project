<content:header />
<?r
	base = controller[:base]
	current_guide = controller[:guide]
?><nav class="subnav" aria-label="Guides"><?r
	base.guides.each do |guide|
		active = guide.name == current_guide&.name
?><a href="#{guide.href}" class="#{active ? 'active' : nil}" aria-current="#{active ? 'page' : 'false'}">#{guide.title}</a><?r
	end
?></nav>
