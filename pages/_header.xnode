<?r
	base = controller[:base]
	section_links = links("/", directories: true, files: false, indices: false)
	current_section = first.node.uri_path.components.find { |component| !component.empty? }
?>
<header>
	<nav class="sections">
		<a href="/" class="project-title">#{base.project_title}</a>
		<?r section_links.each do |link|
			active = link.name == current_section
			?><a href="#{link.href}" class="#{active ? 'active' : nil}">#{link.title}</a><?r
		end
		
		if github_url = base.source_code_uri
		?><a href="#{github_url}" class="github" target="_blank" rel="noopener noreferrer">GitHub ↗</a><?r
		end
		?>
		<pagefind-modal-trigger placeholder="Search" compact hidden></pagefind-modal-trigger>
	</nav>
</header>
